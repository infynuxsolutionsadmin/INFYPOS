generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(255)
  slug               String              @unique @db.VarChar(100)
  domain             String?             @unique @db.VarChar(255)
  status             TenantStatus        @default(ACTIVE)
  plan               TenantPlan          @default(BASIC)
  logoUrl            String?             @map("logo_url") @db.VarChar(500)
  currency           String              @default("USD") @db.VarChar(3)
  timezone           String              @default("UTC") @db.VarChar(50)
  metadata           Json?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  cashRegisters      CashRegister[]
  categories         Category[]
  customers          Customer[]
  discounts          Discount[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  notifications      Notification[]
  payments           Payment[]
  permissions        Permission[]
  products           Product[]
  purchaseOrders     PurchaseOrder[]
  receipts           Receipt[]
  refreshTokens      RefreshToken[]
  roles              Role[]
  sales              Sale[]
  shifts             Shift[]
  stores             Store[]
  suppliers          Supplier[]
  syncQueues         SyncQueue[]
  taxes              Tax[]
  users              User[]
  vatRates           VatRate[]
  invoiceCounters    InvoiceCounter[]

  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

model Store {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  name               String              @db.VarChar(255)
  code               String              @db.VarChar(50)
  address            String?
  addressLine1       String?             @map("address_line1") @db.VarChar(255)
  addressLine2       String?             @map("address_line2") @db.VarChar(255)
  city               String?             @db.VarChar(100)
  state              String?             @db.VarChar(100)
  country            String?             @db.VarChar(100)
  postalCode         String?             @map("postal_code") @db.VarChar(20)
  phone              String?             @db.VarChar(50)
  email              String?             @db.VarChar(255)
  timezone           String              @default("UTC") @db.VarChar(50)
  currency           String              @default("USD") @db.VarChar(3)
  status             StoreStatus         @default(ACTIVE)
  isMain             Boolean             @default(false) @map("is_main")
  metadata           Json?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  cashRegisters      CashRegister[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  sales              Sale[]
  shifts             Shift[]
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncQueues         SyncQueue[]
  userStores         UserStore[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([deletedAt])
  @@index([tenantId, deletedAt])
  @@map("stores")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String?          @map("tenant_id") @db.Uuid
  name            String           @db.VarChar(100)
  description     String?          @db.VarChar(500)
  isSystem        Boolean          @default(false) @map("is_system")
  rank            Int              @default(0)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([rank])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String?          @map("tenant_id") @db.Uuid
  module          String           @db.VarChar(100)
  action          String           @db.VarChar(100)
  code            String           @unique @db.VarChar(200)
  description     String?          @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@index([tenantId])
  @@index([module])
  @@index([deletedAt])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  roleId             String              @map("role_id") @db.Uuid
  email              String              @db.VarChar(255)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  firstName          String              @map("first_name") @db.VarChar(100)
  lastName           String              @map("last_name") @db.VarChar(100)
  phone              String?             @db.VarChar(50)
  avatarUrl          String?             @map("avatar_url") @db.VarChar(500)
  status             UserStatus          @default(ACTIVE)
  lastLoginAt        DateTime?           @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]
  notifications      Notification[]
  purchaseOrders     PurchaseOrder[]
  refreshTokens      RefreshToken[]
  sales              Sale[]
  shifts             Shift[]
  userStores         UserStore[]
  role               Role                @relation(fields: [roleId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([roleId])
  @@index([deletedAt])
  @@index([tenantId, deletedAt])
  @@map("users")
}

model UserStore {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
  @@index([deletedAt])
  @@map("user_stores")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  name        String     @db.VarChar(255)
  slug        String     @db.VarChar(100)
  description String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  categoryId         String?             @map("category_id") @db.Uuid
  vatRateId          String?             @map("vat_rate_id") @db.Uuid
  sku                String              @db.VarChar(100)
  barcode            String?             @db.VarChar(100)
  name               String              @db.VarChar(255)
  description        String?
  brand              String?             @db.VarChar(100)
  unit               String              @default("PCS") @db.VarChar(20)
  costPrice          Decimal             @map("cost_price") @db.Decimal(12, 4)
  sellingPrice       Decimal             @map("selling_price") @db.Decimal(12, 4)
  status             ProductStatus       @default(ACTIVE)
  trackInventory     Boolean             @default(true) @map("track_inventory")
  minimumStock       Decimal             @default(0) @map("minimum_stock") @db.Decimal(12, 4)
  maximumStock       Decimal?            @map("maximum_stock") @db.Decimal(12, 4)
  reorderLevel       Decimal             @default(0) @map("reorder_level") @db.Decimal(12, 4)
  weight             Decimal?            @db.Decimal(8, 3)
  dimensions         String?             @db.VarChar(100)
  metadata           Json?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  barcodes           ProductBarcode[]
  images             ProductImage[]
  category           Category?           @relation(fields: [categoryId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vatRate            VatRate?            @relation(fields: [vatRateId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]
  saleItems          SaleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
  @@index([barcode])
  @@index([status])
  @@index([deletedAt])
  @@map("products")
}

model ProductBarcode {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  barcode   String   @db.VarChar(100)
  type      String   @default("EAN13") @db.VarChar(50)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, barcode])
  @@index([barcode])
  @@map("product_barcodes")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(500)
  altText   String?  @map("alt_text") @db.VarChar(255)
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Inventory {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  storeId       String    @map("store_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  openingStock  Decimal   @default(0) @map("opening_stock") @db.Decimal(12, 4)
  currentStock  Decimal   @default(0) @map("current_stock") @db.Decimal(12, 4)
  reservedStock Decimal   @default(0) @map("reserved_stock") @db.Decimal(12, 4)
  damagedStock  Decimal   @default(0) @map("damaged_stock") @db.Decimal(12, 4)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  product       Product   @relation(fields: [productId], references: [id])
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([tenantId])
  @@index([storeId])
  @@index([productId])
  @@index([deletedAt])
  @@map("inventories")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  storeId       String                @map("store_id") @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  userId        String?               @map("user_id") @db.Uuid
  type          InventoryMovementType
  quantity      Decimal               @db.Decimal(12, 4)
  previousStock Decimal               @map("previous_stock") @db.Decimal(12, 4)
  newStock      Decimal               @map("new_stock") @db.Decimal(12, 4)
  reference     String?               @db.VarChar(255)
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  product       Product               @relation(fields: [productId], references: [id])
  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?                 @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([productId])
  @@index([type])
  @@map("inventory_movements")
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  code           String          @db.VarChar(50)
  name           String          @db.VarChar(255)
  contactPerson  String?         @map("contact_person") @db.VarChar(100)
  email          String?         @db.VarChar(255)
  phone          String?         @db.VarChar(50)
  address        String?
  city           String?         @db.VarChar(100)
  country        String?         @db.VarChar(100)
  taxNumber      String?         @map("tax_number") @db.VarChar(50)
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)
  purchaseOrders PurchaseOrder[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  storeId     String              @map("store_id") @db.Uuid
  supplierId  String              @map("supplier_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  orderNumber String              @map("order_number") @db.VarChar(100)
  status      PurchaseOrderStatus @default(DRAFT)
  subtotal    Decimal             @db.Decimal(12, 4)
  taxAmount   Decimal             @default(0) @map("tax_amount") @db.Decimal(12, 4)
  total       Decimal             @db.Decimal(12, 4)
  expectedAt  DateTime?           @map("expected_at") @db.Timestamptz(6)
  receivedAt  DateTime?           @map("received_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?           @map("deleted_at") @db.Timestamptz(6)
  items       PurchaseOrderItem[]
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id])

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([storeId])
  @@index([supplierId])
  @@index([deletedAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid()) @db.Uuid
  purchaseOrderId  String        @map("purchase_order_id") @db.Uuid
  productId        String        @map("product_id") @db.Uuid
  quantityOrdered  Decimal       @map("quantity_ordered") @db.Decimal(12, 4)
  quantityReceived Decimal       @default(0) @map("quantity_received") @db.Decimal(12, 4)
  unitCost         Decimal       @map("unit_cost") @db.Decimal(12, 4)
  subtotal         Decimal       @db.Decimal(12, 4)
  taxAmount        Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 4)
  total            Decimal       @db.Decimal(12, 4)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  product          Product       @relation(fields: [productId], references: [id])
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model Customer {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  code          String?   @db.VarChar(50)
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String?   @map("last_name") @db.VarChar(100)
  email         String?   @db.VarChar(255)
  phone         String?   @db.VarChar(50)
  address       String?
  city          String?   @db.VarChar(100)
  country       String?   @db.VarChar(100)
  loyaltyPoints Int       @default(0) @map("loyalty_points")
  storeCredit   Decimal   @default(0) @map("store_credit") @db.Decimal(12, 4)
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales         Sale[]

  @@index([tenantId])
  @@index([phone])
  @@index([email])
  @@index([deletedAt])
  @@map("customers")
}

model Sale {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  storeId        String        @map("store_id") @db.Uuid
  cashierId      String        @map("cashier_id") @db.Uuid
  customerId     String?       @map("customer_id") @db.Uuid
  shiftId        String?       @map("shift_id") @db.Uuid
  discountId     String?       @map("discount_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number") @db.VarChar(100)
  receiptNumber  String        @map("receipt_number") @db.VarChar(100)
  status         SaleStatus    @default(COMPLETED)
  paymentStatus  PaymentStatus @default(COMPLETED) @map("payment_status")
  subtotal       Decimal       @db.Decimal(12, 4)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 4)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 4)
  total          Decimal       @db.Decimal(12, 4)
  notes          String?
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  payments       Payment[]
  receipts       Receipt[]
  items          SaleItem[]
  cashier        User          @relation(fields: [cashierId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  discount       Discount?     @relation(fields: [discountId], references: [id])
  shift          Shift?        @relation(fields: [shiftId], references: [id])
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([storeId])
  @@index([cashierId])
  @@index([customerId])
  @@index([status])
  @@index([deletedAt])
  @@map("sales")
}

model SaleItem {
  id             String   @id @default(uuid()) @db.Uuid
  saleId         String   @map("sale_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  vatRateId      String?  @map("vat_rate_id") @db.Uuid
  productName    String   @map("product_name") @db.VarChar(255)
  sku            String   @db.VarChar(100)
  quantity       Decimal  @db.Decimal(12, 4)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 4)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 4)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 4)
  vatRateName    String?  @map("vat_rate_name") @db.VarChar(100)
  vatPercentage  Decimal  @default(0) @map("vat_percentage") @db.Decimal(5, 2)
  subtotal       Decimal  @db.Decimal(12, 4)
  total          Decimal  @db.Decimal(12, 4)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product        Product  @relation(fields: [productId], references: [id])
  sale           Sale     @relation(fields: [saleId], references: [id])
  vatRate        VatRate? @relation(fields: [vatRateId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  saleId         String        @map("sale_id") @db.Uuid
  method         PaymentMethod
  status         PaymentStatus @default(COMPLETED)
  amount         Decimal       @db.Decimal(12, 4)
  transactionRef String?       @map("transaction_ref") @db.VarChar(255)
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  sale           Sale          @relation(fields: [saleId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([saleId])
  @@index([status])
  @@index([deletedAt])
  @@map("payments")
}

model Tax {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(100)
  code        String    @db.VarChar(50)
  type        TaxType   @default(EXCLUSIVE)
  description String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vatRates    VatRate[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("taxes")
}

model VatRate {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  taxId      String     @map("tax_id") @db.Uuid
  name       String     @db.VarChar(100)
  percentage Decimal    @db.Decimal(5, 2)
  isDefault  Boolean    @default(false) @map("is_default")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(6)
  products   Product[]
  saleItems  SaleItem[]
  tax        Tax        @relation(fields: [taxId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([taxId])
  @@index([deletedAt])
  @@map("vat_rates")
}

model Discount {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  code      String?      @db.VarChar(50)
  name      String       @db.VarChar(100)
  type      DiscountType
