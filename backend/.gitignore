# ==========================================
# INFYPOS Backend (NestJS + Prisma) .gitignore
# ==========================================

# Dependencies
node_modules/

# Compiled Output
/dist/
/build/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Files
.DS_Store
Thumbs.db
Desktop.ini

# IDEs & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Testing & Coverage
/coverage/
/.nyc_output/

# Prisma & Generated Assets
prisma/migrations/*_lock.toml

# Temporary & Diagnostic Reports
.temp/
.tmp/
pids/
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Local AI / Scratch Artifacts
.agents/
.claude/
.windsurf/
structure.txt
src-structure.txt
prisma-structure.txt