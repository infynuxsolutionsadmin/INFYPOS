# ==========================================
# INFYPOS Backend Environment Variables
# ==========================================

# Application
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,https://your-frontend-domain.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/infypos?schema=public

# JWT Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# Redis Cache (Optional)
ENABLE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
