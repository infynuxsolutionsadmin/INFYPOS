model Shift {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  storeId        String       @map("store_id") @db.Uuid
  cashRegisterId String       @map("cash_register_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  openingAmount  Decimal      @map("opening_amount") @db.Decimal(12, 4)
  closingAmount  Decimal?     @map("closing_amount") @db.Decimal(12, 4)
  expectedAmount Decimal?     @map("expected_amount") @db.Decimal(12, 4)
  status         ShiftStatus  @default(OPEN)
  openedAt       DateTime     @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt       DateTime?    @map("closed_at") @db.Timestamptz(6)
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  sales          Sale[]
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@map("shifts")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
